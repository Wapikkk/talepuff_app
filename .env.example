# Salin file ini menjadi `.env`. CATATAN: berkas ini ikut dikemas ke dalam APK, jadi
# jangan pernah mengisinya dengan rahasia (kata sandi, kunci API).

# Alamat backend Gin: IP laptop yang menjalankan backend, di jaringan yang SAMA dengan HP.
# Bukan `localhost` dan bukan `10.0.2.2` (itu hanya berlaku untuk emulator).
# Alamatnya juga bisa diubah dari dalam aplikasi: Settings > About > Server Address.
API_BASE_URL=http://192.168.1.10:8080
